# Образец файла подписи Android. Скопируй в key.properties и заполни.
#
# key.properties НЕ коммитится (в .gitignore): там пароль от ключа публикации.
#
# Как создать ключ (один раз):
#   keytool -genkeypair -v -keystore poisk-mirea.jks -storetype JKS ^
#           -keyalg RSA -keysize 2048 -validity 10000 -alias poisk-mirea
#
# Путь storeFile — от каталога app/android/.
#
# ВАЖНО: ключ подписи нельзя терять и нельзя менять после первой публикации
# в Google Play — обновления перестанут устанавливаться. Копию .jks и пароль
# храни вне репозитория (менеджер паролей + резервная копия).
# В CI ключ живёт в секретах ANDROID_KEYSTORE_BASE64 / _PASSWORD /
# ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD.

storeFile=../poisk-mirea.jks
storePassword=ЗАМЕНИ_МЕНЯ
keyAlias=poisk-mirea
keyPassword=ЗАМЕНИ_МЕНЯ
